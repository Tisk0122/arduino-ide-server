[Unit]
Description=Weekly isolated full restore test for Arduino Web IDE
After=local-fs.target
OnFailure=arduino-helper-failure-notice@%p.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/arduino-helper/backup.env
ExecStart=/usr/local/sbin/arduino-helper-verify-backup --full
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5h
